# IOP environment variables — copy to .env and adjust for your deployment.
# Local dev does NOT need any of these: server/configs/dev.yaml already has sane
# defaults that match docker-compose. These overrides matter for PRODUCTION.
#
# Config precedence: env vars (IOP_<SECTION>_<KEY>) override server/configs/<env>.yaml.

# Environment: dev | production. In production the server fails fast unless the
# security-sensitive values below are set safely (see SECURITY.md).
IOP_ENV=production

# --- Database (Postgres) ---
# Production MUST use sslmode=require (dev uses sslmode=disable).
IOP_DB_DSN=postgres://iop:CHANGE_ME@db:5432/iop?sslmode=require

# --- Redis (sessions / rate-limit / idempotency) ---
IOP_REDIS_ADDR=redis:6379

# --- Object storage (MinIO / S3-compatible) ---
IOP_MINIO_ENDPOINT=minio:9000
IOP_MINIO_ACCESS_KEY=CHANGE_ME
IOP_MINIO_SECRET_KEY=CHANGE_ME

# --- Auth ---
# REQUIRED in production: >= 32 chars, random. Generate: openssl rand -base64 48
IOP_AUTH_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# --- CORS (must NOT be "*" in production) ---
# Comma-separated explicit origins; configured in configs/<env>.yaml.

# --- Seeded platform admin ---
# Override the default 'admin / Admin12345!' bootstrap password. If unset, the
# default is used and the admin is forced to change it on first login.
IOP_SEED_ADMIN_PASSWORD=CHANGE_ME

# --- Container image tag (docker-compose.prod.yml) ---
IMAGE_TAG=latest
